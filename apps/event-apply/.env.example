# Copy this file to `.env.local` (git-ignored) and set the backend base URL.
# REQUIRED: this app has NO localhost fallback and hard-fails if unset.
#
# Local backend on this machine:
#   NEXT_PUBLIC_API_URL=http://localhost:8000/HoloraPerformance
# Backend on another computer on the same LAN (use the host's LAN IP):
#   NEXT_PUBLIC_API_URL=http://192.168.1.42:8000/HoloraPerformance
#
# This form is normally opened from the Holora Flutter app with a ?token=<JWT>
# query param; without a token it shows the "open from the Holora app" message.
# Tip: `./scripts/set-api-url.sh <url>` writes this into all four apps at once.
NEXT_PUBLIC_API_URL=http://localhost:8000/HoloraPerformance
